[Unit]
Description=WikiTide durable Agent worker
After=network-online.target

[Service]
Type=simple
User=wikitide
Group=wikitide
WorkingDirectory=/opt/wikitide/current
EnvironmentFile=/etc/wikitide/agent-worker.env
ExecStart=/opt/wikitide/venv/bin/python agent_worker.py --db /var/lib/wikitide/site.db --content /var/lib/wikitide/content
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wikitide

[Install]
WantedBy=multi-user.target
