{
  "name": "wikitide-team-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.admin.config.ts && vite build --config vite.editor.config.ts && vite build --config vite.imports.config.ts",
    "build:editor": "tsc --noEmit && vite build --config vite.editor.config.ts",
    "test": "vitest run",
    "build:imports": "tsc --noEmit && vite build --config vite.imports.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
